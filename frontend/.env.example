# Local development: keep blank so Vite proxies /api to Django.
VITE_API_URL=

# Production / Capacitor:
# VITE_API_URL=https://smart-expense-tracker-v3-production.up.railway.app

# Opt-in only. Omit this variable or use django to keep the existing backend.
VITE_BACKEND_PROVIDER=django

# For a separate Supabase project, set VITE_BACKEND_PROVIDER=supabase and rebuild.
# Browser-public configuration ONLY. Never use sb_secret_* or service_role keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Enable email confirmations and configure SMTP in Supabase Auth before launch.
# Allow the exact frontend redirects (replace the example origin):
# https://your-frontend.example/#/login
# https://your-frontend.example/?auth=recovery#/reset-password
# Add localhost equivalents for development. PKCE email links must be opened on
# the browser/device that initiated signup or recovery. Keep the default
# Supabase ConfirmationURL email-link template; no custom server callback exists.
